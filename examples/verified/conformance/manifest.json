{
  "schema_version": "deedseal.passport-conformance/v1",
  "specification": "docs/passport-spec-v1.md",
  "vectors": [
    {
      "id": "valid-published-passport",
      "why": "The unchanged published passport must be accepted.",
      "input": "vectors/vector-001.json",
      "input_kind": "file",
      "expect_verdict": "PASS",
      "expect_exit_code": 0
    },
    {
      "id": "non-json-input",
      "why": "Text that is not JSON cannot be a passport.",
      "input": "vectors/vector-002.json",
      "input_kind": "file",
      "expect_verdict": "BLOCK",
      "expect_exit_code": 1,
      "expect_reason": "block_run_passport_unparseable"
    },
    {
      "id": "empty-file",
      "why": "An empty file contains no passport object.",
      "input": "vectors/vector-003.json",
      "input_kind": "file",
      "expect_verdict": "BLOCK",
      "expect_exit_code": 1,
      "expect_reason": "block_run_passport_unparseable"
    },
    {
      "id": "truncated-file",
      "why": "A passport cut off before its closing brace is incomplete JSON.",
      "input": "vectors/vector-004.json",
      "input_kind": "file",
      "expect_verdict": "BLOCK",
      "expect_exit_code": 1,
      "expect_reason": "block_run_passport_unparseable"
    },
    {
      "id": "duplicate-json-key",
