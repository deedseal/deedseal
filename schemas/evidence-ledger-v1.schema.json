{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deedseal/deedseal/blob/main/schemas/evidence-ledger-v1.schema.json",
  "title": "Deedseal public evidence ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot",
    "claims",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "deedseal.public-evidence-ledger/v1"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prepared_on",
        "publication_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DS-[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
        },
        "prepared_on": {
          "type": "string",
          "format": "date"
        },
        "publication_status": {
          "enum": [
            "review-candidate",
            "published",
            "superseded"
          ]
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence_index"
      }
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "component": {
      "enum": [
        "CORE",
        "OFFICE",
        "PUBLIC"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "component",
        "status",
        "observed_on",
        "scope",
        "evidence_ids",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CLM-[0-9]{4}$"
        },
        "statement": {
          "$ref": "#/$defs/nonempty_string"
        },
        "component": {
          "$ref": "#/$defs/component"
        },
        "status": {
          "enum": [
            "public-reproducible",
            "public-attested",
            "internally-verified",
            "experimental",
            "design-target",
            "withdrawn"
          ]
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "string",
          "pattern": "^DS-[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVD-[A-Z]+-[0-9]{4}$"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonempty_string"
          }
        }
      }
    },
    "evidence_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "kind",
        "assurance",
        "observed_on",
        "source_snapshot",
        "artifact",
        "redactions",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EVD-[A-Z]+-[0-9]{4}$"
        },
        "component": {
          "$ref": "#/$defs/component"
        },
        "kind": {
          "$ref": "#/$defs/nonempty_string"
        },
        "assurance": {
          "enum": [
            "internal-ci-attestation",
            "public-attestation",
            "public-reproducible"
          ]
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "source_snapshot": {
          "type": "string",
          "pattern": "^(CORE|OFFICE|PUBLIC)-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Z]$"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^evidence/records/EVD-[A-Z]+-[0-9]{4}\\.json$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "redactions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "R-SEC",
              "R-OPS",
              "R-PRIV",
              "R-IP",
              "R-VULN"
            ]
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonempty_string"
          }
        }
      }
    }
  }
}
