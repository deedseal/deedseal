      "ring",
      "concentric ring",
      "shield",
      "padlock",
      "checkmark",
      "document stamp",
      "monogram",
      "robot",
      "brain",
      "neural dot network",
      "sparkle",
      "chat bubble",
      "circuit",
      "appliance silhouette",
      "passport booklet",
      "decorative gradient"
    ]
